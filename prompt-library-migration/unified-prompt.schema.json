{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/HiAPIAI/awesome-ai-product-video-workflows/blob/local-content-integration/prompt-library-migration/unified-prompt.schema.json",
  "title": "Unified video prompt entry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "model",
    "source",
    "title",
    "prompt",
    "capability",
    "tags",
    "media"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,160}$" },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "version"],
      "properties": {
        "family": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "url", "license_status"],
      "properties": {
        "type": {
          "enum": ["community-post", "official-showcase", "original-template"]
        },
        "url": { "type": ["string", "null"], "format": "uri" },
        "author": { "type": ["string", "null"] },
        "license_status": {
          "enum": ["attributed", "first-party", "unknown", "review-required"]
        },
        "attribution": { "type": ["string", "null"] }
      }
    },
    "title": {
      "type": "object",
      "additionalProperties": false,
      "required": ["en"],
      "properties": {
        "en": { "type": "string", "minLength": 1 },
        "zh": { "type": ["string", "null"] }
      }
    },
    "prompt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["en"],
      "properties": {
        "en": { "type": "string", "minLength": 1 },
        "zh": { "type": ["string", "null"] },
        "availability": {
          "enum": ["mirrored", "theme-only", "not-available"]
        }
      }
    },
    "capability": { "type": "string", "minLength": 1 },
    "duration_seconds": { "type": ["integer", "null"], "minimum": 1 },
    "aspect_ratio": { "type": ["string", "null"], "pattern": "^[0-9]+:[0-9]+$" },
    "resolution": { "type": ["string", "null"] },
    "categories": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "tags": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "media": {
      "type": "object",
      "additionalProperties": false,
      "required": ["preview_image", "preview_video", "rights_status"],
      "properties": {
        "preview_image": { "type": ["string", "null"] },
        "preview_video": { "type": ["string", "null"] },
        "rights_status": {
          "enum": ["first-party", "attributed-third-party", "unknown", "review-required"]
        }
      }
    },
    "fallback": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "model": { "type": ["string", "null"] },
        "notes": { "type": ["string", "null"] }
      }
    }
  }
}
