{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/HiAPIAI/awesome-ai-product-video-workflows/main/schemas/workflow.schema.json",
  "title": "AI Product Video Workflow",
  "type": "object",
  "required": [
    "id",
    "slug",
    "title_en",
    "title_zh",
    "description_en",
    "description_zh",
    "steps"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title_en": {
      "type": "string",
      "minLength": 20
    },
    "title_zh": {
      "type": "string",
      "minLength": 8
    },
    "description_en": {
      "type": "string",
      "minLength": 100
    },
    "description_zh": {
      "type": "string",
      "minLength": 40
    },
    "steps": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "required": ["title_en", "body_en", "title_zh", "body_zh"]
      }
    }
  }
}
